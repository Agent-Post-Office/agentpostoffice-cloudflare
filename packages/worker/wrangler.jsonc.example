{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agentpostoffice",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "MAIL_DOMAIN": "mail.example.com",
    "MAX_INBOUND_BYTES": "10485760",
    "BODY_EXCERPT_BYTES": "8192",
    "DLQ_NAME": "agentpostoffice-dlq",
    // off leaves mail in inbox and still stores a score. tag adds the spam label.
    // quarantine moves flagged mail to the spam folder. Mail is never dropped.
    // SPAM_THRESHOLD is 0-100. inbox_spam_settings overrides both per inbox.
    "SPAM_FILTER": "tag",
    "SPAM_THRESHOLD": "60",
    // SPAM_LEARN stays "off" here so scoring stays on the rules filter.
    // Set it to "on" (or "true" or "1") to train naive Bayes from mark-spam and mark-not-spam.
    // After 0008 is applied and this Worker is deployed, backfill marks that already exist:
    //   node packages/cli/dist/index.js messages training-backfill --inbox <inbox-id>
    // Repeat with --cursor until done is true. The first learned delivery also runs one page
    // when that inbox has no training rows yet.
    // SPAM_LEARN_MIN is the marks required in each class before that signal counts.
    "SPAM_LEARN": "off",
    "SPAM_LEARN_MIN": "20"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentpostoffice",
      "database_id": "REPLACE_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAIL_BUCKET",
      "bucket_name": "agentpostoffice-mail"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "MAIL_QUEUE", "queue": "agentpostoffice-mail" }
    ],
    "consumers": [
      {
        "queue": "agentpostoffice-mail",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "agentpostoffice-dlq"
      },
      {
        "queue": "agentpostoffice-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "send_email": [{ "name": "EMAIL" }]
}
